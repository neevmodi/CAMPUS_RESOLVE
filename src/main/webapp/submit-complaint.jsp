<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><title>New complaint</title><link rel="stylesheet" href="css/app.css"></head><body><header class="topbar"><a class="brand" href="student/dashboard">CAMPUS <b>RESOLVE</b></a><form class="logout-form" method="post" action="logout"><input type="hidden" name="csrfToken" value="${csrfToken}"><button type="submit">Sign out</button></form></header><main class="container narrow"><p class="eyebrow">NEW REPORT</p><h1>Tell us what needs attention.</h1><p class="muted">Our transparent rule-based assistant will suggest a category, priority, and department for the team.</p><c:if test="${not empty param.error}"><div class="alert error"><c:out value="${param.error}"/></div></c:if><form class="panel" method="post" action="submit-complaint"><input type="hidden" name="csrfToken" value="${csrfToken}"><label>Title<input name="title" maxlength="180" required placeholder="e.g. Wi-Fi is unavailable in Block B"></label><label>What happened?<textarea name="description" maxlength="10000" minlength="15" required rows="7" placeholder="Include useful context, impact, and when it started."></textarea></label><label>Where is it?<input name="location" maxlength="180" required placeholder="Building, room, or area"></label><button class="button" type="submit">Submit complaint</button></form></main></body></html>
