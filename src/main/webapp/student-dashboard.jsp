<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><title>Student dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/student/dashboard">CAMPUS <b>RESOLVE</b></a><span>Hi, <c:out value="${sessionScope.user.name}"/></span><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrfToken" value="${csrfToken}"><button type="submit">Sign out</button></form></header>
<main class="container"><div class="heading"><div><p class="eyebrow">STUDENT PORTAL</p><h1>Your campus, heard.</h1></div><a class="button" href="${pageContext.request.contextPath}/submit-complaint.jsp">+ New complaint</a></div>
<section class="stats"><div><small>Total reports</small><strong>${complaints.size()}</strong></div><div><small>Open</small><strong>${openCount}</strong></div></section>
<section class="panel"><h2>Recent complaints</h2><div class="table-wrap"><table><tr><th>Issue</th><th>Category</th><th>Priority</th><th>Status</th></tr><c:forEach var="c" items="${complaints}"><tr><td><a href="${pageContext.request.contextPath}/complaint?id=${c.id}">#${c.id} <c:out value="${c.title}"/></a></td><td><c:out value="${c.category}"/></td><td><span class="badge ${c.priority}">${c.priority}</span></td><td><span class="badge">${c.status}</span></td></tr></c:forEach></table></div></section></main></body></html>
