<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><title>Sign in | Campus Resolve</title><link rel="stylesheet" href="css/app.css"></head><body><main class="auth-card"><a class="brand" href="index.jsp">CAMPUS <b>RESOLVE</b></a><h1>Welcome back</h1><p class="muted">Sign in to follow your campus care journey.</p><c:if test="${not empty param.error}"><div class="alert error"><c:out value="${param.error}"/></div></c:if><c:if test="${not empty param.message}"><div class="alert success"><c:out value="${param.message}"/></div></c:if><form method="post" action="login"><input type="hidden" name="csrfToken" value="${csrfToken}"><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="button" type="submit">Sign in</button></form><p class="muted">New student? <a href="register.jsp">Create an account</a></p></main></body></html>
