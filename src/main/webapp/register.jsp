<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><title>Register | Campus Resolve</title><link rel="stylesheet" href="css/app.css"></head><body><main class="auth-card"><a class="brand" href="index.jsp">CAMPUS <b>RESOLVE</b></a><h1>Create your account</h1><c:if test="${not empty param.error}"><div class="alert error"><c:out value="${param.error}"/></div></c:if><form method="post" action="register"><input type="hidden" name="csrfToken" value="${csrfToken}"><label>Full name<input name="name" required maxlength="120"></label><label>College email<input type="email" name="email" required></label><label>Password<input type="password" name="password" minlength="8" required></label><label>Confirm password<input type="password" name="confirm" minlength="8" required></label><button class="button" type="submit">Create account</button></form><p class="muted">Already registered? <a href="login.jsp">Sign in</a></p></main></body></html>
