<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><title>Complaint details</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body>
<header class="topbar"><c:choose><c:when test="${sessionScope.user.role.name() == 'ADMIN'}"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">CAMPUS <b>RESOLVE</b></a></c:when><c:when test="${sessionScope.user.role.name() == 'STAFF'}"><a class="brand" href="${pageContext.request.contextPath}/staff/dashboard">CAMPUS <b>RESOLVE</b></a></c:when><c:otherwise><a class="brand" href="${pageContext.request.contextPath}/student/dashboard">CAMPUS <b>RESOLVE</b></a></c:otherwise></c:choose><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrfToken" value="${csrfToken}"><button type="submit">Sign out</button></form></header>
<main class="container narrow"><p class="eyebrow">COMPLAINT #${complaint.id}</p><h1><c:out value="${complaint.title}"/></h1><c:if test="${not empty param.error}"><div class="alert error"><c:out value="${param.error}"/></div></c:if><c:if test="${not empty param.message}"><div class="alert success"><c:out value="${param.message}"/></div></c:if>
<section class="panel"><p><c:out value="${complaint.description}"/></p><p><b>Location:</b> <c:out value="${complaint.location}"/></p><p><b>Category:</b> <c:out value="${complaint.category}"/> &nbsp; <b>Priority:</b> <span class="badge ${complaint.priority}">${complaint.priority}</span></p><p><b>Department:</b> <c:out value="${complaint.department}"/> &nbsp; <b>Status:</b> <span class="badge">${complaint.status}</span></p><p><b>Resolution notes:</b> <c:out value="${complaint.resolutionNotes}" default="No notes yet."/></p></section>
<c:if test="(sessionScope.user.role.name() == 'STAFF' || sessionScope.user.role.name() == 'ADMIN') && not empty nextStatuses"><section class="panel"><h2>Update complaint</h2><form method="post" action="${pageContext.request.contextPath}/manage-complaint"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="id" value="${complaint.id}"><input type="hidden" name="action" value="status"><label>Status<select name="status"><c:forEach var="s" items="${nextStatuses}"><option value="${s}">${s}</option></c:forEach></select></label><label>Progress note<textarea name="note" rows="3" maxlength="500"></textarea></label><button class="button" type="submit">Save status</button></form></section></c:if>
<c:if test="${sessionScope.user.role.name() == 'ADMIN'}"><section class="panel"><h2>Assignment</h2><form method="post" action="${pageContext.request.contextPath}/manage-complaint"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="id" value="${complaint.id}"><input type="hidden" name="action" value="assign"><label>Department<input name="department" value="${complaint.department}" required maxlength="120"></label><label>Staff member<select name="staffId" required><option value="">Choose a staff member</option><c:forEach var="person" items="${staff}"><option value="${person.id}" ${person.id == complaint.assignedStaffId ? 'selected' : ''}><c:out value="${person.name}"/></option></c:forEach></select></label><button class="button" type="submit">Assign complaint</button></form></section></c:if>
<section class="panel"><h2>Status history</h2><c:forEach var="entry" items="${history}"><div class="history-item"><span class="badge">${entry.status}</span><span><c:out value="${entry.note}"/></span><small>${entry.changedAt}</small></div></c:forEach></section></main></body></html>
